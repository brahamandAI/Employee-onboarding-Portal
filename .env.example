# =============================================================================
# Rakshak Securitas EOMS — Environment template
# Copy to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# App URL
# -----------------------------------------------------------------------------
# Production: set these to the public HTTPS origin (e.g. https://eoms.example.com)
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Auth secrets (min 32 characters each)
# Generate: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=
EMPLOYEE_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# MongoDB (include database name in URI)
# Example: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/onboarding_management?retryWrites=true&w=majority
# URL-encode special password chars (@ → %40)
# -----------------------------------------------------------------------------
MONGODB_URI=

# -----------------------------------------------------------------------------
# Cloudinary — required for document uploads
# https://cloudinary.com/console
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Branding
# -----------------------------------------------------------------------------
COMPANY_NAME=Rakshak Securitas

# -----------------------------------------------------------------------------
# Email (optional in dev — OTP logs to console if not set)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@rakshaksecuritas.com
